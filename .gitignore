/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Mm]emoryCaptures/
/[Rr]ecordings/
/[Uu]serSettings/

# ---------- 资产元数据：只在对应资产被忽略时才忽略 meta ----------
!/[Aa]ssets/**/*.meta

