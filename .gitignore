# ---------- Unity 生成目录（体积巨大，必须排除） ----------
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Mm]emoryCaptures/
/[Rr]ecordings/
/[Uu]serSettings/

# ---------- 资产元数据：只在对应资产被忽略时才忽略 meta ----------
!/[Aa]ssets/**/*.meta

# ---------- IDE / 编辑器工程文件 ----------
.vs/
.idea/
.vscode/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity 生成的 meta
*.pidb.meta
*.pdb.meta
*.mdb.meta

# 崩溃日志
sysinfo.txt

# ---------- 构建产物 ----------
*.apk
*.aab
*.unitypackage
*.app

# Addressables 打包产物
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# ---------- 第三方素材 ----------
# 不纳入版本控制，两个原因：
# 1) 授权：Quaternius Bestiary 包用的是 QAL v1.0，明确禁止"把素材本身再分发"。
#    仓库一旦公开（GitHub 等）就构成再分发 → 违反授权。授权凭证已另存 Docs/素材授权/（受控）。
# 2) 体积：188 MB 二进制，且是可重新下载的只读素材，版本控制无收益。
# 注意：本目录仍需保留在磁盘上，Unity 要用。
/Assets/ThirdParty/
# 各平台的冗余导出格式（GLB/glTF/blend/Unreal 法线），已移出 Assets
/_RawDownloads/

# ---------- 工程内部数据 ----------
.workbuddy/

# ---------- 操作系统杂项 ----------
.DS_Store
Thumbs.db
desktop.ini
